    return env


def engine_args(cfg, rank):
    args = ['--model-path', cfg['model_path'], '--served-model-name', cfg['served_model_name'],
            '--trust-remote-code', '--tp-size', cfg['tp_size'], '--dcp-size', cfg['dcp_size'],
            '--nnodes', len(cfg['nodes']), '--node-rank', rank,
            '--dist-init-addr', f'{head(cfg)["host"]}:{cfg["dist_init_port"]}',
            '--kv-cache-dtype', cfg['kv_cache_dtype'], '--mamba-ssm-dtype', cfg['mamba_ssm_dtype'],
            '--mem-fraction-static', cfg['mem_fraction_static'], '--context-length', cfg['context_length'],
            '--max-running-requests', cfg['max_running_requests'],
            '--reasoning-parser', 'kimi_k3', '--tool-call-parser', 'kimi_k3',
            '--watchdog-timeout', cfg['watchdog_timeout'], '--disable-flashinfer-autotune',
            '--model-loader-extra-config', json.dumps({'enable_multithread_load': True}),
            '--host', cfg['bind_host'], '--port', cfg['port'], '--enable-metrics']
    if rank == 0:
        # Native authentication; the key stays out of argv.
        args += ['--config', AUTH_CONFIG]
    if not cfg['radix_cache']:
        args.append('--disable-radix-cache')
    if cfg.get('enforce_thinking_budget'):
        # Every rank's scheduler applies the grammar mask, so every rank gets the flag.
        args.append('--enable-strict-thinking')
    spec = cfg.get('speculative')
    if spec:
        args += ['--speculative-algorithm', 'DFLASH', '--speculative-draft-model-path', spec['draft_model_path'],
                 '--speculative-draft-attention-backend', 'cutedsl_mla',
                 '--speculative-draft-kv-cache-dtype', cfg['kv_cache_dtype'],
                 '--speculative-num-draft-tokens', spec['num_draft_tokens'],
                 '--speculative-use-block-verification', '--enable-linear-replayssm-spec']
    args += cfg.get('extra_args', [])
    return [str(value) for value in args]


def serve(cfg, rank):
    if os.getpgrp() != os.getpid():
        os.setpgrp()
    env = launch_environment(cfg)
    # Bind host allocations, page cache included, to Grace RAM: reading the 1.45 TiB checkpoint
    # would otherwise spill page cache into HBM mid-load. Device allocations ignore this policy.
    membind = ','.join(path.name[4:] for path in numa_nodes()[0])
    command = [str(NUMACTL), f'--membind={membind}',
               str(VENV / 'bin/python'), str(ROOT / 'kimictl'), '_engine', *engine_args(cfg, rank)]
    state = dict(proc_info(os.getpid()), rank=rank, command=command, config=cfg,
                 started_at=time.time(), log=str(LOG), overlay_audit=env.get('KIMI_CHECKPOINT_AUDIT_DIR'))
    temporary = STATE.with_suffix('.tmp')
    temporary.write_text(json.dumps(state, indent=2) + '\n')
    temporary.replace(STATE)
    print('LAUNCH ' + json.dumps(command), flush=True)
    os.execve(command[0], command, env)


def engine():
    # What `sglang serve` does for an LLM, behind this file's log redaction.
    from sglang.launch_server import run_server
    from sglang.srt.plugins import load_plugins
    from sglang.srt.server_args import prepare_server_args
    from sglang.srt.utils import kill_process_tree
    load_plugins()
    server_args = prepare_server_args(sys.argv[2:])
    if config().get('enable_web_search') and server_args.node_rank == 0:
        from web_search import install
        install(api_key=API_KEY.read_text().strip(), exa_api_key=EXA_KEY.read_text().strip())
    try:
        run_server(server_args)
    finally:
        kill_process_tree(os.getpid(), include_parent=False)


def node_start(cfg, rank):
    os.umask(0o077)
    with locked('node'):
        state = tracked_state()
        if session_exists(cfg) or state_is_alive(state):
            raise RuntimeError('this node already runs an owned engine; stop it first')
        if state and group_members(state['pgid']):
            raise RuntimeError('owned child processes remain; run stop before starting')
        report = node_preflight(cfg, rank)
        if report['problems']:
            raise RuntimeError('preflight failed: ' + '; '.join(report['problems']))
        (ROOT / 'logs').mkdir(exist_ok=True)
        if LOG.exists():
            stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
            LOG.rename(ROOT / 'logs' / f'sglang-{stamp}.log')
        command = 'exec ' + shlex.join([sys.executable, str(ROOT / 'kimictl'), '_serve', '--rank', str(rank)])
        command += ' > ' + shlex.quote(str(LOG)) + ' 2>&1'
        tmux('new-session', '-d', '-s', session_name(cfg), '-c', ROOT, command)


def wait_for_exit(pgid, seconds):
    deadline = time.monotonic() + seconds
    while group_members(pgid) and time.monotonic() < deadline:
        time.sleep(1)
    return [item['pid'] for item in group_members(pgid)]


def node_stop(cfg, mode, timeout):
    """Stop this node's engine and wait for the driver to release its GPUs.

    drain: SIGTERM the engine's main process only. On rank 0 SGLang finishes in-flight requests,
        then broadcasts ShutdownReq, so every rank's schedulers free GPU state in userspace and exit.
    await: signal nothing; a follower exits once rank 0's ShutdownReq has stopped its schedulers.
    force: SIGTERM, then SIGKILL, the whole process group, for ranks that cannot drain (a dead peer
        or a hang). SGLang notes that killing a scheduler mid-release is how GPU memory outlives it.
    """
    with locked('node'):
        state = tracked_state()
        remaining = []
        if state:
            info = proc_info(state['pid'])
            if info and info['start_ticks'] != state['start_ticks']:
                raise RuntimeError('tracked PID was reused; refusing to signal it')
            main_alive = bool(info and info['state'] != 'Z')
            pgid = state['pgid']
            if mode == 'force':
                for sig, grace in ((signal.SIGTERM, 30), (signal.SIGKILL, 30)):
                    if group_members(pgid):
                        os.killpg(pgid, sig)
                        remaining = wait_for_exit(pgid, grace)
            else:
                if mode == 'drain' and main_alive:
                    os.kill(state['pid'], signal.SIGTERM)
                # Without a live main process nothing here will drain; report the orphans at once.
                remaining = wait_for_exit(pgid, timeout if main_alive else 5)
        if remaining:
            return {'stopped': False, 'remaining': remaining}
        if session_exists(cfg):
            tmux('kill-session', '-t', session_name(cfg))
        deadline = time.monotonic() + GPU_RELEASE_SECONDS
        while True:
            gpus, apps = gpu_report()
            problems = idle_problems(gpus, apps)
            if not problems or time.monotonic() >= deadline:
                break
            time.sleep(2)
        return {'stopped': True, 'remaining': [], 'gpu_problems': problems,
                'gpu_memory_used_mib': [gpu['memory_used_mib'] for gpu in gpus]}


def node_status(cfg):
    state = tracked_state()
    gpus, apps = gpu_report()
    alive = state_is_alive(state)
    loads = []
    if alive and state.get('overlay_audit'):
        for path in sorted(Path(state['overlay_audit']).glob('rank-*.json')):
            record = json.loads(path.read_text())
            loads.append({key: record.get(key) for key in
                          ('rank', 'manifest_sha256', 'tensor_count', 'overlay', 'base')})
    return {'tmux': session_exists(cfg), 'engine': alive, 'pid': state['pid'] if alive else None,
            'uptime_s': int(time.time() - state['started_at']) if alive else None, 'overlay_loads': loads,
            'gpu_memory_used_mib': [gpu['memory_used_mib'] for gpu in gpus],
            'recovery_actions': sorted({gpu['recovery_action'] for gpu in gpus}), 'compute_apps': len(apps)}


# ----- cluster actions (run on c04) -----

def on_node(node, *args, timeout=120):
    """Run a kimictl subcommand on a node; locally when that node is this one."""
    command = ['/usr/bin/python3', str(ROOT / 'kimictl'), *map(str, args)]
    if node['hostname'] != socket.gethostname().split('.')[0]:
        command = [*SSH, node['host'], shlex.join(command)]
    return subprocess.run(command, text=True, capture_output=True, timeout=timeout)


def on_all(cfg, *args, timeout=120):
    with concurrent.futures.ThreadPoolExecutor(len(cfg['nodes'])) as pool:
        return list(pool.map(lambda node: on_node(node, *args, timeout=timeout), cfg['nodes']))


def node_json(node, result):
    if result.returncode:
        raise RuntimeError(f'{node["name"]}: ' + (result.stderr.strip().splitlines() or ['failed'])[-1])
    return json.loads(result.stdout)


def require_head(cfg):
    if this_rank(cfg) != 0:
        raise RuntimeError(f'run cluster commands on {head(cfg)["name"]}')


def auth_headers():
    return {'Authorization': 'Bearer ' + API_KEY.read_text().strip()} if API_KEY.exists() else {}


def request(cfg, path, timeout=5):
    req = urllib.request.Request(f'http://{head(cfg)["host"]}:{cfg["port"]}{path}', headers=auth_headers())
    with OPENER.open(req, timeout=timeout) as response:
        return response.read()


def healthy(cfg):
    try:
        # /health runs a one-token generation; it takes about 1 s idle and longer under load.
        request(cfg, '/health', timeout=20)
        return True
    except (OSError, urllib.error.URLError):
        return False


def init_key():
    """Create the API key and the admin key, or add the admin key to an existing API key."""
    if ADMIN_KEY.exists():
        raise RuntimeError(f'{PRIVATE} already holds both keys; remove them deliberately to rotate')
    PRIVATE.mkdir(mode=0o700, exist_ok=True)
    created = []
    if API_KEY.exists():
        key = API_KEY.read_text().strip()
    else:
        key = 'sk-kimi-' + secrets.token_urlsafe(32)
        write_secret(API_KEY, key + '\n')
        created.append(API_KEY)
    admin = 'sk-kimi-admin-' + secrets.token_urlsafe(32)
    write_secret(ADMIN_KEY, admin + '\n')
    write_secret(AUTH_CONFIG, f'api-key: {key}\nadmin-api-key: {admin}\n')
    created += [ADMIN_KEY, AUTH_CONFIG]
    print(f'Wrote {", ".join(map(str, created))} (mode 0600); a running server picks them up on restart.')


def write_secret(path, text):
    # Write beside the target and rename, so a reader never sees a partial file.
    temp = path.with_name(path.name + '.tmp')
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as handle:
        handle.write(text)
    os.replace(temp, path)


def sync(cfg):
    """Push the runtime files (not secrets, venvs or weights) to the worker nodes."""
    require_head(cfg)
    files = [name for name in RUNTIME_FILES if (ROOT / name).exists()]
    def push(node):
        subprocess.run([*SSH, node['host'], shlex.join(['mkdir', '-p', str(ROOT)])], check=True, timeout=30)
        subprocess.run([str(RSYNC), '-a', '-e', shlex.join(SSH), f'--rsync-path={RSYNC}',
                        *[str(ROOT / name) for name in files], f'{node["host"]}:{ROOT}/'],
                       check=True, timeout=120)
    with concurrent.futures.ThreadPoolExecutor(3) as pool:
        list(pool.map(push, cfg['nodes'][1:]))
    print(f'Synchronized {", ".join(files)} to {", ".join(node["name"] for node in cfg["nodes"][1:])}.')


def preflight(cfg, quiet=False):
    require_head(cfg)
    reports = [node_json(node, result) for node, result in zip(cfg['nodes'], on_all(cfg, '_preflight'))]
    ok = True
    for node, report in zip(cfg['nodes'], reports):
        if report['digests'] != reports[0]['digests']:
            report['problems'].append('runtime files differ from c04; run sync')
        ok &= not report['problems']
        if not quiet or report['problems'] or report['warnings']:
            used = '/'.join(str(gpu['memory_used_mib']) for gpu in report['gpus'])
            print(f'{node["name"]}: {"ok" if not report["problems"] else "BLOCKED"}; GPU MiB used {used}')
            for line in report['problems']:
                print(f'  problem: {line}')
            for line in report['warnings']:
                print(f'  warning: {line}')
    return ok


def node_stops(nodes, mode, timeout):
    def one(node):
        try:
            return node_json(node, on_node(node, '_stop', '--mode', mode, '--timeout', timeout,
                                           timeout=timeout + GPU_RELEASE_SECONDS + 180))
        except (RuntimeError, ValueError, subprocess.TimeoutExpired) as exc:
            return {'stopped': False, 'error': str(exc)}
    with concurrent.futures.ThreadPoolExecutor(max(len(nodes), 1)) as pool:
        return dict(zip([node['name'] for node in nodes], pool.map(one, nodes)))


def stop(cfg, force=False, drain_timeout=600):
    require_head(cfg)
    if state_is_alive(tunnel_state()):
        # Only a running, validated server is published; start the tunnel again by hand.
        tunnel_stop()
    rank0, followers = cfg['nodes'][0], cfg['nodes'][1:]
    results = node_stops([rank0], 'drain', drain_timeout)
    # Followers exit by themselves within seconds of rank 0's ShutdownReq.
    results |= node_stops(followers, 'await', 120 if results[rank0['name']]['stopped'] else 0)
    stuck = [node for node in cfg['nodes'] if not results[node['name']]['stopped']]
    if stuck and force:
        results |= node_stops(stuck, 'force', 0)
    clean = True
    for node in cfg['nodes']:
        result = results[node['name']]
        if 'error' in result:
            line, clean = f'stop failed: {result["error"]}', False
        elif not result['stopped']:
            line, clean = f'still running (pids {result["remaining"]})', False
        elif result['gpu_problems']:
            line, clean = 'stopped, but the GPUs are not free: ' + '; '.join(result['gpu_problems']), False
        else:
            line = 'stopped; GPU MiB ' + '/'.join(map(str, result['gpu_memory_used_mib']))
        print(f'{node["name"]}: {line}')
    if clean:
        print('Owned Kimi K3.1 engines stopped on all nodes and their GPUs are free. '
              'Logs and model files are preserved.')
        return 0
    if not force and any(not result['stopped'] for result in results.values()):
        print('The graceful stop did not finish. Read the logs, then `kimictl stop --force` signals '
              'the remaining processes.')
    else:
        print('Do not restart or reset anything; report these nodes for driver and process inspection.')
    return 1


def log_tail(node, lines=40):
    result = on_node(node, '_logs', '-n', lines)
    return result.stdout if result.returncode == 0 else result.stderr


def start(cfg, no_wait):
    require_head(cfg)
    with locked('cluster'):
        if healthy(cfg):
            print(f'Already healthy: http://{head(cfg)["host"]}:{cfg["port"]}/v1')
            return 0
        statuses = [node_json(node, result) for node, result in zip(cfg['nodes'], on_all(cfg, '_status'))]
        running = [node['name'] for node, status in zip(cfg['nodes'], statuses) if status['tmux'] or status['engine']]
        if running:
            raise RuntimeError(f'engines are starting or unhealthy on {", ".join(running)}; inspect status/logs')
        sync(cfg)
        for node, result in zip(cfg['nodes'], on_all(cfg, '_drop-cache', timeout=300)):
            if result.returncode:
                raise RuntimeError(f'{node["name"]}: dropping page cache failed: {result.stderr.strip()}')
        if not preflight(cfg, quiet=True):
            raise RuntimeError('preflight failed; nothing was started')
        for rank, node in enumerate(cfg['nodes']):
            result = on_node(node, '_start', '--rank', rank)
            if result.returncode:
                # Ranks waiting for a peer that never came cannot drain.
                stop(cfg, force=True, drain_timeout=60)
                raise RuntimeError(f'{node["name"]} failed to start: {result.stderr.strip()}')
    print(f'Started TP{cfg["tp_size"]} DCP{cfg["dcp_size"]} on {", ".join(n["name"] for n in cfg["nodes"])}. '
          f'Logs: {LOG} on each node.', flush=True)
    if no_wait:
        return 0
    started = time.monotonic()
    deadline = started + cfg['startup_timeout_seconds']
    report_at = 0
    while time.monotonic() < deadline:
        if healthy(cfg):
            print(f'Ready after {int(time.monotonic() - started)} s: http://{head(cfg)["host"]}:{cfg["port"]}/v1; '
                  f'model={cfg["served_model_name"]}')
            return 0
        if time.monotonic() >= report_at:
            statuses = [node_json(node, result) for node, result in zip(cfg['nodes'], on_all(cfg, '_status'))]
            dead = [node for node, status in zip(cfg['nodes'], statuses) if not status['engine']]
            if dead:
                # Read rank 0 first: a rank that exits often takes the others down with gloo errors.
                print(f'Engine exited on {", ".join(node["name"] for node in dead)} during startup.')
                for node in cfg['nodes']:
                    print(f'--- {node["name"]} log tail ---\n{log_tail(node)}')
                # The surviving ranks are blocked on the dead one and cannot drain.
                stop(cfg, force=True, drain_timeout=60)
                return 1
            memory = ' '.join(f'{node["name"]}={max(status["gpu_memory_used_mib"]) // 1024}G'
                              for node, status in zip(cfg['nodes'], statuses))
            print(f'[{int(time.monotonic() - started)} s] loading weights / capturing graphs; max GPU use {memory}',
                  flush=True)
            report_at = time.monotonic() + 60
        time.sleep(10)
    print('Readiness timed out; engines were left running. Inspect status/logs before restarting.')
    return 1


def status(cfg):
    require_head(cfg)
    is_healthy = healthy(cfg)
    print(f'API: {"healthy" if is_healthy else "not ready"} (http://{head(cfg)["host"]}:{cfg["port"]}/v1)')
    all_up, states = True, []
    for node, result in zip(cfg['nodes'], on_all(cfg, '_status')):
        try:
            state = node_json(node, result)
        except RuntimeError as exc:
            print(f'{node["name"]}: unreachable ({exc})')
            all_up = False
            continue
        all_up &= state['engine']
        states.append(state)
        uptime = f'up {state["uptime_s"] // 60} min, pid {state["pid"]}' if state['engine'] else 'down'
        print(f'{node["name"]}: tmux {"up" if state["tmux"] else "down"}; engine {uptime}; '
              f'GPU MiB {"/".join(map(str, state["gpu_memory_used_mib"]))}; '
              f'recovery {",".join(state["recovery_actions"])}')
    live = tracked_state()
    if live and state_is_alive(live):
        cfg = live['config']
        spec = cfg.get('speculative')
        print(f'Model: {cfg["served_model_name"]}; TP{cfg["tp_size"]} DCP{cfg["dcp_size"]}; '
              f'context {cfg["context_length"]:,}; max running {cfg["max_running_requests"]}; '
              f'radix cache {"on" if cfg["radix_cache"] else "off"}; '
              f'decoding {"DFLASH x" + str(spec["num_draft_tokens"]) if spec else "plain"}')
        print(f'Anthropic extras: web search {"Exa" if cfg.get("enable_web_search") else "off"}; '
              f'thinking budget {"enforced" if cfg.get("enforce_thinking_budget") else "off"}; '
              f'effort medium -> {cfg.get("medium_effort_as") or "unmapped (HTTP 500)"}')
        print(f'Weights: {weights_summary(cfg, states)[0]}')
    print(f'Tunnel: {"running" if state_is_alive(tunnel_state()) else "stopped"} '
          f'(frp server port {TUNNEL_PORT}; kimictl tunnel status)')
    return 0 if is_healthy and all_up else 1


def weights_summary(cfg, states):
    """(text, ok) for the weights a running config loaded, from every rank's overlay load record."""
    loads = [load for state in states for load in state.get('overlay_loads', [])]
    if not cfg.get('checkpoint_overlay'):
        return ('official', True) if not loads else (f'official, but {len(loads)} ranks report an overlay', False)
    from checkpoint_overlay import MANIFEST_SHA256, REVISION, TENSORS
    expected = (MANIFEST_SHA256, TENSORS, str(Path(cfg['checkpoint_overlay']).resolve()),
                str(Path(cfg['model_path']).resolve()))
    ranks = sorted(load['rank'] for load in loads
                   if (load['manifest_sha256'], load['tensor_count'], load['overlay'], load['base']) == expected)
    return (f'abliterated (pqhaz {REVISION[:12]} overlay, {TENSORS} tensors; loaded on {len(ranks)}/'
            f'{cfg["tp_size"]} ranks)', ranks == list(range(cfg['tp_size'])))


def weights(cfg, expect):
    """Exit 0 only if every node's engine runs and loaded the weights its config names (modelctl)."""
    require_head(cfg)
    live = tracked_state()
    states = [node_json(node, result) for node, result in zip(cfg['nodes'], on_all(cfg, '_status'))]
    if not state_is_alive(live) or not all(state['engine'] for state in states):
        print('Weights: unknown; the engines are not running on every node')
        return 1
    text, ok = weights_summary(live['config'], states)
    print(f'Weights: {text}')
    variant = 'abliterated' if live['config'].get('checkpoint_overlay') else 'official'
    if expect and expect != variant:
        print(f'expected {expect} weights')
        ok = False
    return 0 if ok else 1


# ----- frp tunnel (c04 only; modelled on ds.deploy's ds41ctl) -----

def tunnel_state():
    return json.loads(FRPC_STATE.read_text()) if FRPC_STATE.exists() else None


def check_tunnel_config(cfg):
    """The config must hold exactly the approved rule, forwarding to this server's API."""
    rules = tomllib.loads(FRPC_CONFIG.read_text()).get('proxies', [])
    expected = {'name': TUNNEL_NAME, 'type': 'tcp', 'localIP': cfg['bind_host'],
                'localPort': cfg['port'], 'remotePort': TUNNEL_PORT}
    if len(rules) != 1 or {key: rules[0].get(key) for key in expected} != expected:
        raise RuntimeError(f'{FRPC_CONFIG} must hold exactly one rule: {expected}')


def gost_listening():
    with socket.socket() as probe:
        probe.settimeout(1)
        return probe.connect_ex(GOST_ADDRESS) == 0


def require_authenticated_api(cfg):
    if not healthy(cfg):
        raise RuntimeError('the API is not healthy; validate the server before exposing it')
    request(cfg, '/v1/models')
    try:
        with OPENER.open(f'http://{cfg["bind_host"]}:{cfg["port"]}/v1/models', timeout=10):
            raise RuntimeError('refusing to expose an API that accepts unauthenticated requests')
    except urllib.error.HTTPError as error:
        if error.code != 401:
            raise RuntimeError(f'expected HTTP 401 without the API key, got {error.code}') from error
    # A read-only admin endpoint: the shared API key must not reach the admin surface.
    admin = urllib.request.Request(f'http://{cfg["bind_host"]}:{cfg["port"]}/list_external_corpora',
                                   headers=auth_headers())
    try:
        with OPENER.open(admin, timeout=10):
            raise RuntimeError('refusing to expose an API whose key also opens the admin endpoints')
    except urllib.error.HTTPError as error:
        if error.code != 401:
            raise RuntimeError(f'expected HTTP 401 for an admin endpoint with the API key, got {error.code}') from error


def start_gost():
    """Start the loopback HTTP proxy frpc dials through, unless one is listening already."""
    if gost_listening():
        return None
    child = subprocess.Popen(['nohup', str(GOST), '-L', GOST_URL], cwd=ROOT, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    deadline = time.monotonic() + 10
    while not gost_listening():
        if child.poll() is not None or time.monotonic() > deadline:
            raise RuntimeError('gost did not start listening on 127.0.0.1:18080')
        time.sleep(0.2)
    return child.pid


def check_gost_transport():
    # A real DNS-over-HTTPS lookup through gost, before frpc depends on it.
    proxy = urllib.request.build_opener(urllib.request.ProxyHandler({'https': 'http://127.0.0.1:18080'}))
    lookup = urllib.request.Request('https://1.1.1.1/dns-query?name=ssh.linsyking.com&type=A',
                                    headers={'Accept': 'application/dns-json'})
    with proxy.open(lookup, timeout=20) as response:
        answer = json.load(response)
    if answer.get('Status') != 0 or not answer.get('Answer'):
        raise RuntimeError('DNS-over-HTTPS lookup of ssh.linsyking.com through gost failed')


def tunnel_start(cfg):
    require_head(cfg)
    os.umask(0o077)
    with locked('tunnel'):
        if state_is_alive(tunnel_state()):
            return tunnel_status(cfg)
        missing = [path for path in (FRPC_CONFIG, API_KEY, AUTH_CONFIG, FRPC, GOST) if not path.exists()]
        if missing:
            raise RuntimeError('missing ' + ', '.join(map(str, missing)))
        check_tunnel_config(cfg)
        require_authenticated_api(cfg)
        verify = subprocess.run([str(FRPC), 'verify', '-c', str(FRPC_CONFIG)], capture_output=True, timeout=15)
        if verify.returncode:
            raise RuntimeError(f'frpc verify failed (exit {verify.returncode}); run it by hand on c04')
        gost_pid = start_gost()
        check_gost_transport()
        offset = FRPC_LOG.stat().st_size if FRPC_LOG.exists() else 0
        with FRPC_LOG.open('ab') as log:
            child = subprocess.Popen(['nohup', str(FRPC), '-c', str(FRPC_CONFIG)], cwd=ROOT,
                                     stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                     start_new_session=True)
        deadline = time.monotonic() + 30
        while f'[{TUNNEL_NAME}] start proxy success' not in FRPC_LOG.read_text(errors='replace')[offset:]:
            if child.poll() is not None:
                raise RuntimeError(f'frpc exited with {child.returncode}; inspect {FRPC_LOG}')
            if time.monotonic() > deadline:
                print(f'frpc is running but has not logged "start proxy success" yet; inspect {FRPC_LOG}')
                break
            time.sleep(0.5)
        FRPC_STATE.write_text(json.dumps(dict(proc_info(child.pid), started_at=time.time(), gost_pid=gost_pid),
                                         indent=2) + '\n')
    return tunnel_status(cfg)


def tunnel_stop():
    with locked('tunnel'):
        state = tunnel_state()
        if state_is_alive(state):
            os.killpg(state['pgid'], signal.SIGTERM)
            deadline = time.monotonic() + 10
            while state_is_alive(state) and time.monotonic() < deadline:
                time.sleep(0.2)
            if state_is_alive(state):
                raise RuntimeError('frpc did not exit after SIGTERM')
    print('Tunnel stopped. The loopback gost proxy is left running.')
    return 0


def tunnel_status(cfg):
    alive = state_is_alive(tunnel_state())
    print(f'Tunnel: {"running" if alive else "stopped"} ({TUNNEL_NAME}: frp server port {TUNNEL_PORT} -> '
          f'{cfg["bind_host"]}:{cfg["port"]}); gost {"listening" if gost_listening() else "not listening"}')
    print(f'Server-local API on ssh.linsyking.com: http://127.0.0.1:{TUNNEL_PORT}/v1, '
          f'model {cfg["served_model_name"]}; log {FRPC_LOG}')
    if FRPC_LOG.exists():
        for line in FRPC_LOG.read_text(errors='replace').splitlines()[-6:]:
            print('  ' + line)
    return 0 if alive else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    commands = {name: sub.add_parser(name)
                for name in ['preflight', 'sync', 'start', 'stop', 'restart', 'status', 'init-key']}
    for name in ['stop', 'restart']:
        commands[name].add_argument('--drain-timeout', type=int, default=600,
                                    help='seconds rank 0 may spend finishing in-flight requests')
        commands[name].add_argument('--force', action='store_true',
                                    help='signal processes that did not stop gracefully (a dead rank or a hang)')
    for name in ['start', 'restart']:
        commands[name].add_argument('--no-wait', action='store_true')
    sub.add_parser('weights', help='which weights the running engines loaded').add_argument(
        '--expect', choices=['official', 'abliterated'])
    sub.add_parser('tunnel', help='publish the API through frp on remote port 8313').add_argument(
        'tunnel_action', choices=['start', 'stop', 'status'])
    logs = sub.add_parser('logs')
    logs.add_argument('--node', default='c04', choices=list(NODES))
    logs.add_argument('-n', type=int, default=60)
    logs.add_argument('-f', '--follow', action='store_true')
    for name in ['_start', '_serve']:
        sub.add_parser(name).add_argument('--rank', type=int, required=True)
    for name in ['_preflight', '_status', '_drop-cache']:
        sub.add_parser(name)
    node_stopper = sub.add_parser('_stop')
    node_stopper.add_argument('--mode', choices=['drain', 'await', 'force'], required=True)
    node_stopper.add_argument('--timeout', type=int, required=True)
    sub.add_parser('_logs').add_argument('-n', type=int, default=60)
    if len(sys.argv) > 1 and sys.argv[1] == '_engine':
        return engine()
    args = parser.parse_args()
    if args.action == 'init-key':
        return init_key()
    cfg = config()
    if args.action == '_preflight':
        print(json.dumps(node_preflight(cfg, this_rank(cfg))))
    elif args.action == '_start':
        node_start(cfg, args.rank)
    elif args.action == '_serve':
        serve(cfg, args.rank)
    elif args.action == '_stop':
        print(json.dumps(node_stop(cfg, args.mode, args.timeout)))
    elif args.action == '_status':
        print(json.dumps(node_status(cfg)))
    elif args.action == '_drop-cache':
        drop_page_cache(cfg)
    elif args.action == '_logs':
        return subprocess.call(['tail', '-n', str(args.n), str(LOG)])
    elif args.action == 'preflight':
        return 0 if preflight(cfg) else 1
    elif args.action == 'sync':
        sync(cfg)
    elif args.action == 'start':
        return start(cfg, args.no_wait)
    elif args.action == 'stop':
        return stop(cfg, args.force, args.drain_timeout)
    elif args.action == 'restart':
        # Never start onto GPUs a failed stop left busy.
        return stop(cfg, args.force, args.drain_timeout) or start(cfg, args.no_wait)
    elif args.action == 'status':
        return status(cfg)
    elif args.action == 'weights':
        return weights(cfg, args.expect)
    elif args.action == 'tunnel':
        require_head(cfg)
        if args.tunnel_action == 'start':
            return tunnel_start(cfg)
        if args.tunnel_action == 'stop':
            return tunnel_stop()
        return tunnel_status(cfg)
    elif args.action == 'logs':
        require_head(cfg)
        node = next(node for node in cfg['nodes'] if node['name'] == args.node)
        command = ['tail', '-F' if args.follow else f'-n{args.n}', str(LOG)]
        if node['hostname'] != socket.gethostname().split('.')[0]:
            command = [*SSH, node['host'], shlex.join(command)]
        return subprocess.call(command)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, ValueError) as exc:
        print(f'error: {exc}', file=sys.stderr)
        sys.exit(1)
