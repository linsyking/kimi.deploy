def redact_log_records():
    # SGLang logs server_args, api_key included. Also runs when multiprocessing imports this
    # entrypoint in scheduler processes.
    keys = [path.read_text().strip() for path in (API_KEY, ADMIN_KEY, EXA_KEY) if path.exists()]
    keys = [key for key in keys if key]
    if not keys:
        return

    def redact(text):
        for key in keys:
            text = text.replace(key, '<redacted>')
        return text

    class RedactedStream:
        def __init__(self, stream):
            self.stream = stream

        def write(self, value):
            self.stream.write(redact(value))
            return len(value)

        def flush(self):
            return self.stream.flush()

        def __getattr__(self, name):
            return getattr(self.stream, name)

    sys.stderr = RedactedStream(sys.stderr)
    sys.stdout = RedactedStream(sys.stdout)
    previous = logging.getLogRecordFactory()

    def factory(*args, **kwargs):
        record = previous(*args, **kwargs)
        message = record.getMessage()
        if any(key in message for key in keys):
            record.msg, record.args = redact(message), ()
        return record

    logging.setLogRecordFactory(factory)


