def gpu_report():
    xml = run(['nvidia-smi', '-q', '-x'], timeout=30).stdout
    gpus = []
    for gpu in ET.fromstring(xml).findall('gpu'):
        def field(path):
            return (gpu.findtext(path) or 'Unknown').strip()
        gpus.append({
            'recovery_action': field('gpu_recovery_action'),
            'fabric_state': field('fabric/state'),
            'fabric_status': field('fabric/status'),
            'fabric_health': field('fabric/health/summary'),
            'memory_used_mib': int(used) if (used := field('fb_memory_usage/used').split()[0]).isdigit() else -1,
        })
    apps = run(['nvidia-smi', '--query-compute-apps=pid,process_name,used_memory', '--format=csv,noheader'],
               timeout=30).stdout.strip()
    return gpus, apps.splitlines() if apps else []


def idle_problems(gpus, apps):
    problems = []
    for index, gpu in enumerate(gpus):
        if gpu['memory_used_mib'] < 0:
            problems.append(f'GPU {index} memory use is unreadable')
        elif gpu['memory_used_mib'] > GPU_IDLE_MIB:
            problems.append(f'GPU {index} has {gpu["memory_used_mib"]} MiB in use')
    if apps:
        problems.append('GPUs have compute processes: ' + '; '.join(apps))
    return problems


def other_users():
    me = os.getuid()
    uids = set()
    for path in Path('/proc').iterdir():
        if path.name.isdigit():
            with contextlib.suppress(FileNotFoundError):
                uid = path.stat().st_uid
                if uid >= 1000 and uid not in (me, 65534):
                    uids.add(uid)
    names = []
    for uid in sorted(uids):
        try:
            names.append(pwd.getpwuid(uid).pw_name)
        except KeyError:
            names.append(str(uid))
    return names


def numa_nodes():
    """(Grace CPU nodes, CPU-less nodes). The GPUs' HBM is onlined as CPU-less NUMA nodes (ATS)."""
    cpu, hbm = [], []
    for path in sorted(Path('/sys/devices/system/node').glob('node[0-9]*'), key=lambda p: int(p.name[4:])):
        (cpu if (path / 'cpulist').read_text().strip() else hbm).append(path)
    return cpu, hbm


def hbm_page_cache_gib():
    total_kb = 0
    for path in numa_nodes()[1]:
        match = re.search(r'FilePages:\s+(\d+) kB', (path / 'meminfo').read_text())
        total_kb += int(match.group(1)) if match else 0
    return total_kb / 2**20


def model_dirs(cfg):
    spec = cfg.get('speculative')
    return [Path(cfg['model_path'])] + ([Path(spec['draft_model_path'])] if spec else [])


def drop_page_cache(cfg):
    """Drop the model files' clean cached pages (posix_fadvise DONTNEED; no root needed).

    Grace RAM (~958 GiB) is smaller than the checkpoint, so earlier reads of it leave page cache
    in HBM, which cudaMemGetInfo counts as used and SGLang would subtract from the KV pool."""
    overlay = [Path(cfg['checkpoint_overlay'])] if cfg.get('checkpoint_overlay') else []
    for root in model_dirs(cfg) + overlay:
        for path in [root] if root.is_file() else root.rglob('*'):
            if path.is_file():
                fd = os.open(path, os.O_RDONLY)
                try:
                    os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
                finally:
                    os.close(fd)


def port_free(host, port):
    probe = socket.socket()
    # As uvicorn and torch's TCPStore bind: TIME-WAIT sockets left by a stop do not block them.
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        probe.bind((host, port))
        return True
    except OSError:
        return False
    finally:
        probe.close()


def runtime_digests():
    import hashlib
    return {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest()
            for name in RUNTIME_FILES if (ROOT / name).exists()}


def node_preflight(cfg, rank):
    """Problems block a start; warnings are reported only."""
    problems, warnings = [], []
    required = [VENV / 'bin/python', VENV / 'kimi-build.json', TMUX, NUMACTL]
    required += [root / VERIFIED for root in model_dirs(cfg)]
    if rank == 0:
        required += [API_KEY, ADMIN_KEY, AUTH_CONFIG]
    problems += [f'missing {path}' for path in required if not path.exists()]
    if rank == 0 and cfg.get('enable_web_search') and not (EXA_KEY.exists() and EXA_KEY.read_text().strip()):
        problems.append(f'web search is enabled but {EXA_KEY} is missing or empty')
    if cfg.get('checkpoint_overlay'):
        from checkpoint_overlay import check
        try:
            check(cfg['model_path'], cfg['checkpoint_overlay'])
        except (OSError, ValueError, KeyError) as exc:
            problems.append(f'checkpoint overlay: {exc}')
    gpus, apps = gpu_report()
    if len(gpus) != 4:
        problems.append(f'expected 4 GPUs, found {len(gpus)}')
    for index, gpu in enumerate(gpus):
        if gpu['recovery_action'] != 'None':
            problems.append(f'GPU {index} recovery action is {gpu["recovery_action"]}')
        if (gpu['fabric_state'], gpu['fabric_status'], gpu['fabric_health']) != ('Completed', 'Success', 'Healthy'):
            problems.append(f'GPU {index} fabric is {gpu["fabric_state"]}/{gpu["fabric_status"]}/{gpu["fabric_health"]}')
    problems += idle_problems(gpus, apps)
    cache = hbm_page_cache_gib()
    if cache >= 1:
        problems.append(f'{cache:.0f} GiB of page cache sits in HBM (counted as GPU memory in use); '
                        'start drops the model files\' share, other files\' cache needs their owner')
    imex = subprocess.run(['systemctl', 'is-active', 'nvidia-imex'], text=True, capture_output=True).stdout.strip()
    if imex != 'active':
        problems.append(f'nvidia-imex is {imex or "unknown"}')
    if rank == 0:
        for port in (cfg['port'], cfg['dist_init_port']):
            if not port_free(cfg['bind_host'] if port == cfg['port'] else head(cfg)['host'], port):
                problems.append(f'port {port} is in use')
    users = other_users()
    if users:
        warnings.append('other users have processes here: ' + ', '.join(users))
    return {'problems': problems, 'warnings': warnings, 'gpus': gpus, 'digests': runtime_digests()}


