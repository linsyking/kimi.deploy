def config():
    cfg = json.loads(CONFIG_PATH.read_text())
    names = [node['name'] for node in cfg['nodes']]
    if names != list(NODES):
        raise RuntimeError(f'nodes must be {list(NODES)} in rank order; got {names}')
    for node in cfg['nodes']:
        if (node['host'], node['hostname']) != NODES[node['name']]:
            raise RuntimeError(f'{node["name"]} must be {NODES[node["name"]]}')
    if cfg['tp_size'] != 4 * len(cfg['nodes']):
        raise ValueError('tp_size must be 4 GPUs per node')
    if cfg['tp_size'] % cfg['dcp_size']:
        raise ValueError('dcp_size must divide tp_size')
    if not 0 < cfg['mem_fraction_static'] < 1:
        raise ValueError('mem_fraction_static must be between zero and one')
    spec = cfg.get('speculative')
    if spec is not None and spec.get('algorithm') != 'DFLASH':
        raise ValueError('speculative must be null or a DFLASH block')
    if not isinstance(cfg.get('checkpoint_overlay', ''), str):
        raise ValueError('checkpoint_overlay must be a path string or absent')
    return cfg


def head(cfg):
    return cfg['nodes'][0]


def this_rank(cfg):
    hostname = socket.gethostname().split('.')[0]
    for rank, node in enumerate(cfg['nodes']):
        if node['hostname'] == hostname:
            return rank
    raise RuntimeError(f'{hostname} is not one of the configured nodes')


def run(command, **kwargs):
    return subprocess.run([str(v) for v in command], check=True, text=True, capture_output=True, **kwargs)


def tmux(*args, check=True):
    return subprocess.run([str(TMUX), '-S', str(SOCKET), *map(str, args)], check=check, text=True,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def session_name(cfg):
    return 'kimi-' + cfg['nodes'][this_rank(cfg)]['name']


def session_exists(cfg):
    return tmux('has-session', '-t', session_name(cfg), check=False).returncode == 0


def proc_info(pid):
    try:
        fields = Path(f'/proc/{pid}/stat').read_text().rpartition(')')[2].split()
        return {'pid': int(pid), 'state': fields[0], 'pgid': int(fields[2]), 'start_ticks': fields[19]}
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        return None


def group_members(pgid):
    found = []
    for path in Path('/proc').iterdir():
        if path.name.isdigit():
            item = proc_info(path.name)
            if item and item['pgid'] == pgid and item['state'] != 'Z':
                found.append(item)
    return found


def tracked_state():
    return json.loads(STATE.read_text()) if STATE.exists() else None


def state_is_alive(state):
    if not state:
        return False
    info = proc_info(state['pid'])
    return bool(info and info['state'] != 'Z' and info['start_ticks'] == state['start_ticks'])


@contextlib.contextmanager
def locked(name):
    RUNS.mkdir(exist_ok=True)
    with (RUNS / f'{name}.lock').open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


